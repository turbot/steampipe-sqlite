# Always enable netgo for the build
BUILD_TAGS = netgo

# The linker flags follow the target OS (GOOS), not the host, so a Darwin
# build cross-compiled on Linux gets the Darwin flags.
ifeq ($(shell go env GOOS),darwin)
	export CGO_LDFLAGS = -Wl,-undefined,dynamic_lookup
else
	export CGO_LDFLAGS = -Wl,--unresolved-symbols=ignore-in-object-files
endif

build:
	go build -tags "$(BUILD_TAGS)" -buildmode=c-shared -ldflags="-w -s" -o steampipe_sqlite_{{.Plugin}}.so
